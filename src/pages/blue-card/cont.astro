---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlueCardFace from "../../components/BlueCardFace.astro";
import { readSigned } from "../../lib/auth";
import { findSubscriber } from "../../lib/store";

const id = readSigned(Astro.cookies.get("nordisk_member")?.value);
const subscriber = id ? await findSubscriber(id) : null;
if (!subscriber) return Astro.redirect("/blue-card");

const walletNote = Astro.url.searchParams.get("portofel") === "1";
const name = `${subscriber.firstName} ${subscriber.lastName}`;
---

<Base page="company-page" title="Cont — Blue Card" description="Contul tău Blue Card.">
  <Header label="Nordisk" href="/despre" rightLabel="Produse" rightHref="/" />
  <main class="blue-page">
    <section class="section account">
      <div class="wrap">
        <p class="kicker">Cont</p>
        <h1>{name}</h1>
        <p class="deck">{subscriber.cardCode}</p>
        {walletNote && <p class="notice bad">Portofelul Apple și Google se activează după ce Nordisk își pune certificatul. Până atunci cardul rămâne aici.</p>}
        <nav class="user-menu" aria-label="Cont">
          <a href="#cardul">Cardul meu</a>
          <a href="/api/wallet/apple">Apple Wallet</a>
          <a href="/api/wallet/google">Google Wallet</a>
          <form method="post" action="/api/blue-card/logout">
            <button type="submit">Ieși</button>
          </form>
        </nav>
        <div class="account-card" id="cardul">
          <BlueCardFace name={name} code={subscriber.cardCode} />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
