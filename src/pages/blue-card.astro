---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";
import BlueCardFace from "../components/BlueCardFace.astro";
import { benefits } from "../data/blue-card";

const error = Astro.url.searchParams.get("eroare");
const errors: Record<string, string> = {
  completeaza: "Completează prenumele, numele, telefonul și o parolă de cel puțin 6 caractere.",
  exista: "Acest număr are deja un Blue Card. Intră cu telefonul și parola.",
  intrare: "Telefonul sau parola nu se potrivesc.",
};
---

<Base
  page="company-page"
  title="Blue Card — Nordisk Grup"
  description="Blue Card este certificarea digitală Nordisk Grup pentru meseriașii din construcții. Profil verificat, vizibilitate și cereri de lucrări."
>
  <Header label="Nordisk" href="/despre" rightLabel="Produse" rightHref="/" />
  <main id="top">
    <section>
      <div class="wrap intro">
        <div class="intro-copy">
          <p class="kicker">Nordisk Grup</p>
          <h1>Blue Card</h1>
          <p class="deck">Carnetul digital al meseriașului verificat</p>
          <p class="lead">
            Completezi datele și primești cardul, cu numele tău și un cod unic.
          </p>
          {error && errors[error] && <p class="notice bad">{errors[error]}</p>}
          <form class="form" method="post" action="/api/blue-card/register">
            <label>
              Prenume
              <input name="firstName" autocomplete="given-name" required />
            </label>
            <label>
              Nume
              <input name="lastName" autocomplete="family-name" required />
            </label>
            <label>
              Număr de telefon
              <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
            </label>
            <label>
              Parolă
              <input name="password" type="password" autocomplete="new-password" minlength="6" required />
            </label>
            <button class="btn" type="submit">Primește Blue Card</button>
          </form>
        </div>
        <BlueCardFace spin />
      </div>
    </section>

    <section class="section" id="intrare">
      <div class="wrap">
        <h2 class="section-title">Ai deja Blue Card</h2>
        <form class="form" method="post" action="/api/blue-card/login">
          <label>
            Număr de telefon
            <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
          </label>
          <label>
            Parolă
            <input name="password" type="password" autocomplete="current-password" required />
          </label>
          <button class="btn" type="submit">Deschide cardul</button>
        </form>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="section-title">Pentru cine este</h2>
        <div class="services">
          <article>
            <h3>Pentru meseriaș</h3>
            <p>Un carnet digital de membru. Arată că ai trecut prin verificarea Nordisk și îți adună la un loc meseria, experiența și lucrările.</p>
          </article>
          <article>
            <h3>Pentru client</h3>
            <p>Când cauți pe cineva pentru o lucrare, Blue Card te ajută să vezi cine este verificat și ce a mai făcut, înainte să suni.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="section-title">Ce primești</h2>
        <div class="services">
          {
            benefits.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <Contact note="Pentru Blue Card sau pentru o verificare." />
  </main>
  <Footer />
</Base>
