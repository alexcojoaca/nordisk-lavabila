---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";
import { benefits } from "../data/blue-card";
import { site } from "../data/site";
---

<Base
  page="company-page"
  title="Blue Card — Nordisk Grup"
  description="Blue Card este certificarea digitală Nordisk Grup pentru meseriașii din construcții. Profil verificat, vizibilitate și cereri de lucrări."
>
  <Header label="Nordisk" href="/despre" />
  <main id="top">
    <section>
      <div class="wrap intro">
        <div class="intro-copy">
          <p class="kicker">Certificare</p>
          <h1>Blue Card</h1>
          <p class="deck">Carnetul digital al meseriașului verificat</p>
          <p class="lead">
            Blue Card este certificarea pe care Nordisk Grup o emite meseriașilor din construcții, după un proces de verificare. Clienții recunosc mai ușor un profesionist cu experiență. Meseriașul capătă vizibilitate și un profil pe care îl poate arăta.
          </p>
          <a class="more" href={site.blueCardUrl}>Cere Blue Card
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M4 9h10M10 5l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
        <div class="paycard showcase" aria-hidden="true">
          <span class="stamp">Nordisk</span>
          <span class="paycard-mid">
            <span class="paycard-kicker">Certificare</span>
            <span class="paycard-name">Blue Card</span>
          </span>
          <span class="pay-foot">
            <span>Nordisk Grup</span>
            <span class="card-mark">NG</span>
          </span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="section-title">Pentru cine este</h2>
        <div class="services">
          <article>
            <h3>Pentru meseriaș</h3>
            <p>Un carnet digital de membru. Arată că ai trecut prin verificarea Nordisk și îți adună la un loc meseria, experiența și lucrările.</p>
          </article>
          <article>
            <h3>Pentru client</h3>
            <p>Când cauți pe cineva pentru o lucrare, Blue Card te ajută să vezi cine este verificat și ce a mai făcut, înainte să suni.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="section-title">Ce primești</h2>
        <div class="services">
          {
            benefits.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
        <div class="note">
          <h3>Fără promisiuni goale</h3>
          <p>Acestea sunt beneficiile prezentate de Nordisk Grup. Blue Card nu garantează un anumit număr de clienți sau de lucrări.</p>
        </div>
      </div>
    </section>

    <section class="section" id="portofel">
      <div class="wrap">
        <h2 class="section-title">În telefon</h2>
        <div class="services">
          <article>
            <h3>Apple Wallet</h3>
            <p>Pe iPhone, cardul emis poate sta în Portofel, lângă celelalte carduri. Îl deschizi când ești pe șantier sau la client.</p>
          </article>
          <article>
            <h3>Google Wallet</h3>
            <p>Pe Android, același carnet digital se păstrează în Google Wallet. Nu mai cauți o poză prin telefon.</p>
          </article>
        </div>
        <p class="lead wallet-note">Cardul se adaugă în portofel după ce Nordisk ți-l emite. Până atunci, cererea se face de aici sau la telefon.</p>
      </div>
    </section>

    <Contact note="Pentru Blue Card sau pentru o verificare." />
  </main>
  <Footer label="Nordisk Grup" linkHref="/" linkLabel="Produse" />
</Base>
