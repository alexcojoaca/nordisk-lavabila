---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BlueCardFace from "../components/BlueCardFace.astro";
import { benefits } from "../data/blue-card";

const error = Astro.url.searchParams.get("eroare");
const errors: Record<string, string> = {
  completeaza: "Completează prenumele, numele, telefonul și o parolă de cel puțin 6 caractere.",
  exista: "Acest număr are deja un Blue Card. Intră cu telefonul și parola.",
  intrare: "Telefonul sau parola nu se potrivesc.",
  server: "Cardul nu a putut fi salvat. Încearcă din nou.",
};
---

<Base
  page="company-page"
  title="Blue Card — Nordisk Grup"
  description="Blue Card Nordisk Grup este carnetul digital pentru meseriașii din construcții. Îl ceri cu numele și telefonul și primești cardul cu un cod unic."
>
  <Header label="Nordisk" href="/despre" rightLabel="Produse" rightHref="/" />
  <main id="top" class="blue-page">
    <section>
      <div class="wrap intro">
        <div class="intro-copy">
          <p class="kicker">Nordisk Grup</p>
          <h1>Blue Card</h1>
          <p class="deck">Carnetul digital al meseriașului verificat</p>
        </div>
        <BlueCardFace />
        <div class="hero-actions">
          <a class="btn" href="#formular">Fă-ți Blue Card</a>
          <a class="btn ghost" href="#conectare">Conectare</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="section-title">Pentru meseriași</h2>
        <div class="story">
          <p>
            Blue Card este carnetul digital Nordisk Grup pentru meseriașii din construcții. Îl cer zugravii, zidarii, instalatorii, fierarii-betoniști și echipele care lucrează pe șantier și vor un card cu numele lor, nu un anunț pierdut prin telefon.
          </p>
          <p>
            Înscrierea se face aici: prenume, nume, număr de telefon și o parolă. Nordisk primește datele, iar tu primești cardul, gata de arătat.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="section-title">Ce primești</h2>
        <div class="services">
          {
            benefits.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="formular">
      <div class="wrap">
        <h2 class="section-title">Primește Blue Card</h2>
        {error && error !== "intrare" && errors[error] && <p class="notice bad">{errors[error]}</p>}
        <form class="form" method="post" action="/api/blue-card/register">
          <label>
            Prenume
            <input name="firstName" autocomplete="given-name" required />
          </label>
          <label>
            Nume
            <input name="lastName" autocomplete="family-name" required />
          </label>
          <label>
            Număr de telefon
            <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
          </label>
          <label>
            Parolă
            <input name="password" type="password" autocomplete="new-password" minlength="6" required />
          </label>
          <button class="btn" type="submit">Primește Blue Card</button>
        </form>
        <details class="login-fold" id="conectare" open={error === "intrare"}>
          <summary class="btn ghost">Conectare</summary>
          {error === "intrare" && <p class="notice bad">{errors.intrare}</p>}
          <form class="form" method="post" action="/api/blue-card/login">
            <label>
              Număr de telefon
              <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
            </label>
            <label>
              Parolă
              <input name="password" type="password" autocomplete="current-password" required />
            </label>
            <button class="btn" type="submit">Intră</button>
          </form>
        </details>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    const fold = document.getElementById("conectare");
    if (fold instanceof HTMLDetailsElement && location.hash === "#conectare") fold.open = true;
    document.querySelectorAll('a[href="#conectare"]').forEach((link) => {
      link.addEventListener("click", () => {
        if (fold instanceof HTMLDetailsElement) fold.open = true;
      });
    });
  </script>
</Base>
