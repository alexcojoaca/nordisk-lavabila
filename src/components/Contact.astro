---
import { site } from "../data/site";

interface Props {
  note?: string;
}

const { note } = Astro.props;
---

<section class="contact" id="contact">
  <div class="wrap">
    <h2>Date de contact</h2>
    <a href={site.phoneHref}>{site.phoneDisplay}</a>
    {note && <p>{note}</p>}
  </div>
</section>
