---
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="logo" href="/">Nordisk</a>
      <p>Construcții și vopsele.</p>
    </div>
    <nav aria-label="Pagini">
      <a href="/">Produse</a>
      <a href="/despre">Firmă</a>
      <a href="/blue-card">Blue Card</a>
    </nav>
    <div>
      <p class="footer-label">Date de contact</p>
      <a class="footer-phone" href={site.phoneHref}>{site.phoneDisplay}</a>
      <a class="footer-mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
  <div class="wrap foot-bottom">
    <span>Nordisk Grup</span>
  </div>
</footer>
