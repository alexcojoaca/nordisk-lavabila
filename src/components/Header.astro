---
interface Props {
  label: string;
  href: string;
  rightLabel?: string;
  rightHref?: string;
}

const { label, href, rightLabel = "Blue Card", rightHref = "/blue-card" } = Astro.props;
---

<header>
  <div class="wrap bar">
    <a class="logo" href={href}>{label}</a>
    <a class="nav-card" href={rightHref}>{rightLabel}</a>
  </div>
</header>
