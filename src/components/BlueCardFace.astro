---
interface Props {
  href?: string;
  spin?: boolean;
  name?: string;
  code?: string;
}

const { href, spin = false, name, code } = Astro.props;
---

<div class:list={["spin-scene", { spinning: spin }]}>
  <div class="spin-card">
    {
      href ? (
        <a class="paycard" href={href} aria-label="Deschide pagina Blue Card">
          <span class="stamp">Nordisk</span>
          <span class="paycard-mid">
            <span class="paycard-name">Blue Card</span>
          </span>
          <span class="pay-foot">
            <span>Nordisk Grup</span>
            <span class="card-mark">NG</span>
          </span>
        </a>
      ) : (
        <div class:list={["paycard", { issued: Boolean(name) }]}>
          <span class="stamp">Nordisk</span>
          <span class="paycard-mid">
            {name ? <span class="holder">{name}</span> : <span class="paycard-name">Blue Card</span>}
            {name && <span class="paycard-name small">Blue Card</span>}
          </span>
          <span class="pay-foot">
            <span class="card-code">{code || "Nordisk Grup"}</span>
            <span class="card-mark">NG</span>
          </span>
        </div>
      )
    }
    {
      spin && (
        <div class="paycard spin-face spin-back" aria-hidden="true">
          <span class="paycard-name">Blue Card</span>
        </div>
      )
    }
  </div>
</div>
